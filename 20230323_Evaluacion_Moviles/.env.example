# ============================================================
# CampusPass — Variables de entorno de Firebase (EJEMPLO)
# ============================================================
# 1. Copia este archivo y renómbralo a ".env"
# 2. Reemplaza cada valor con las credenciales reales de tu
#    proyecto de Firebase (Firebase Console > Project settings).
# 3. NUNCA subas el archivo ".env" a GitHub. Ya está incluido
#    en .gitignore.
#
# Expo carga automáticamente cualquier variable que empiece con
# el prefijo EXPO_PUBLIC_ y la expone en tiempo de compilación
# a través de process.env, sin necesidad de librerías extra.
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
